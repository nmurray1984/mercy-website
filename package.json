{
  "name": "mercy-website",
  "version": "1.0.0",
  "private": true,
  "description": "Mercy Presbyterian Church website — static public site + Node admin",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "build": "node build/build.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed-content.js",
    "create-user": "node bin/create-user.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest tests/unit tests/integration",
    "test:ui": "playwright test",
    "test:ui:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.3.0",
    "better-sqlite3-session-store": "^0.1.0",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "marked": "^14.1.2",
    "multer": "^1.4.5-lts.1",
    "nunjucks": "^3.2.4",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  }
}
