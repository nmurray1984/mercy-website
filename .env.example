# Copy to .env and fill in. Never commit .env.

# Where the SQLite database lives
DATABASE_PATH=./data/mercy.sqlite

# Where the built public site is written
PUBLIC_DIR=./public

# Where uploaded images are saved (under PUBLIC_DIR/assets/img/uploads in production)
UPLOAD_DIR=./site/assets/img/uploads

# Port the Node admin app listens on
PORT=3000

# Session secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# CSRF secret. Same generation instructions.
CSRF_SECRET=replace-me-with-another-long-random-string

# Cookies set "Secure" flag. Set to "false" only for local dev over http.
COOKIE_SECURE=true

# How long an idle session lasts, in seconds.
SESSION_IDLE_SECONDS=43200

# Trust the X-Forwarded-* headers from nginx
TRUST_PROXY=1

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info
