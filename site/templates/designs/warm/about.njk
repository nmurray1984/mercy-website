{% extends "designs/warm/_layout.njk" %}
{% block title %}{{ "about.title" | t }}{% endblock %}

{% block content %}

<section class="page-head">
  <div class="container">
    <div class="kicker">{{ "about.kicker" | t }}</div>
    <h1>{{ "about.headline" | thtml }}</h1>
    <p class="deck">{{ "about.deck" | t }}</p>
  </div>
</section>

<section class="tight">
  <div class="container">
    <div class="split">
      <div>
        <div class="section-label"><span class="roman">i.</span><span>Our mission</span></div>
      </div>
      <div>
        <p class="italic-display" style="font-size:1.9rem; line-height:1.3; color:var(--ink);">{{ "about.mission.body" | thtml }}</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-soft">
  <div class="container">
    <div class="section-label"><span class="roman">ii.</span><span>Three commitments</span></div>
    <div class="commitments">
      <div class="commitment">
        <span class="roman">I</span>
        <h3>{{ "about.commitments.gathering.title" | t }}</h3>
        <p>{{ "about.commitments.gathering.body" | thtml }}</p>
        <div class="verse">{{ "about.commitments.gathering.verse" | t }}</div>
      </div>
      <div class="commitment">
        <span class="roman">II</span>
        <h3>{{ "about.commitments.growing.title" | t }}</h3>
        <p>{{ "about.commitments.growing.body" | thtml }}</p>
        <div class="verse">{{ "about.commitments.growing.verse" | t }}</div>
      </div>
      <div class="commitment">
        <span class="roman">III</span>
        <h3>{{ "about.commitments.going.title" | t }}</h3>
        <p>{{ "about.commitments.going.body" | thtml }}</p>
        <div class="verse">{{ "about.commitments.going.verse" | t }}</div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="split">
      <div>
        <div class="section-label"><span class="roman">iii.</span><span>What we believe</span></div>
        <h2>{{ "about.beliefs.headline" | thtml }}</h2>
      </div>
      <div>
        <p class="dropcap">{{ "about.beliefs.body_1" | thtml }}</p>
        <p>{{ "about.beliefs.body_2" | thtml }}</p>
        <div class="mt-40" style="display:flex; gap:16px; flex-wrap:wrap;">
          <a href="{{ "about.beliefs.link_1_url" | t }}" class="link-arrow">{{ "about.beliefs.link_1_text" | t }} <span class="arrow">&rarr;</span></a>
          <a href="{{ "about.beliefs.link_2_url" | t }}" class="link-arrow">{{ "about.beliefs.link_2_text" | t }} <span class="arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="leadership" class="bg-soft">
  <div class="container">
    <div class="section-label"><span class="roman">iv.</span><span>Our staff</span></div>
    <h2 style="margin-bottom:40px;">{{ "about.staff.headline" | thtml }}</h2>
    <div class="card leaders">{{ "about.staff.body" | thtml }}</div>
  </div>
</section>

<section>
  <div class="container">
    <div class="split">
      <div>
        <div class="section-label"><span class="roman">v.</span><span>Session of Elders</span></div>
        <p class="muted" style="margin-bottom:24px;">{{ "about.elders.intro" | thtml }}</p>
        <div class="card roster">{{ "about.elders.body" | thtml }}</div>
      </div>
      <div>
        <div class="section-label"><span class="roman">vi.</span><span>Diaconate</span></div>
        <p class="muted" style="margin-bottom:24px;">{{ "about.deacons.intro" | thtml }}</p>
        <div class="card roster">{{ "about.deacons.body" | thtml }}</div>
      </div>
    </div>
  </div>
</section>

<section class="pull-quote bg-soft">
  <div class="container-narrow">
    <span class="mark">&ldquo;</span>
    <blockquote>{{ "about.pullquote.body" | thtml }}</blockquote>
    <div class="attr">{{ "about.pullquote.attr" | t }}</div>
  </div>
</section>

{% endblock %}
